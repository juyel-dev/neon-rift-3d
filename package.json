    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
